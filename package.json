{
  "name": "decision-support-platform-nesfic-d-36",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted Government Knowledge, Rules & Document Assistant (NESFIC-D-36) for Assam Governance, AASC & Dispur Secretariat",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "start": "npm run --workspace=apps/api start",
    "dev:api": "npm run --workspace=apps/api dev",
    "dev:web": "npm run --workspace=apps/web dev",
    "build:cloudflare": "echo '✅ Cloudflare Pages assets ready at apps/web/public'",
    "deploy:cloudflare": "npx wrangler pages deploy apps/web/public --project-name=nesfic-d36-decision-support",
    "dev:cloudflare": "npx wrangler pages dev apps/web/public"
  },
  "keywords": [
    "nesfic-d-36",
    "assam-government",
    "decision-support-platform",
    "aasc",
    "assam-administrative-staff-college",
    "service-rules",
    "pension-rules-1969",
    "rag",
    "generative-ai",
    "dispur-secretariat"
  ],
  "author": "NESFIC Innovators",
  "license": "Apache-2.0"
}
